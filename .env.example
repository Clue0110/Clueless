# Copy to .env.local (gitignored) and fill in. Never commit real keys.

# Which LLM Clueless uses. One of: gemini | claude | openai
LLM_PROVIDER=gemini

# Set the key for whichever provider you chose above (only that one is needed):
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional — override the default model IDs without touching code:
# LLM_PITCH_MODEL=
# LLM_CHAT_MODEL=

# Optional — rate limiting. If unset, limiting is disabled (fine for local dev).
# Create a free Redis DB at https://upstash.com and paste its REST creds:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Contact form — sign up free at https://resend.com and paste the API key.
RESEND_API_KEY=
# Where contact messages are delivered (defaults to the site owner's email):
# CONTACT_TO_EMAIL=
# Verified sender. Without a verified domain, use Resend's test sender below,
# which can only deliver to the email your Resend account is registered with:
# CONTACT_FROM_EMAIL=Clueless <onboarding@resend.dev>
